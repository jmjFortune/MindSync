# Copy to .env. Generate hex secrets with: openssl rand -hex 32
MINDSYNC_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Bind 127.0.0.1 behind a reverse proxy; set NAS LAN IP for LAN-only access.
MINDSYNC_BIND_ADDRESS=127.0.0.1
MINDSYNC_PORT=8080
MINDSYNC_MAX_FILE_BYTES=52428800

# Manual GC only: protect uncommitted objects for 7 days.
MINDSYNC_GC_GRACE_SECONDS=604800
