# Copy to .env. Generate hex secrets with: openssl rand -hex 32
NAS_SYNC_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Bind 127.0.0.1 behind a reverse proxy; set NAS LAN IP for LAN-only access.
NAS_SYNC_BIND_ADDRESS=127.0.0.1
NAS_SYNC_PORT=8080
NAS_SYNC_MAX_FILE_BYTES=52428800
