# MindSync 库定义模板。
#
# 一个库 = 一个服务端实例 + 一个数据目录 + 一个管理令牌。
# 不要把本文件复制成 libraries/<库名>.env 后手工改一半：请使用
#   sh scripts/add-library.sh <库名> <端口> <数据目录>
# 它会在提示下读取你输入的令牌与数据库密码，并完成目录、属主与启动。
#
# 每个库必须使用互不相同的 MINDSYNC_PORT 与 MINDSYNC_DATA_DIR。

# 库名。compose 项目名与容器名由 add-library.sh 自动填写：
# 第一个库为 mindsync / mindsync / postgres，之后新增的库自动加后缀。
# 所有库命令都要显式传 -p（用 env 里的 MINDSYNC_PROJECT）。
MINDSYNC_LIBRARY=example

# 该库在宿主机发布的端口。
MINDSYNC_PORT=8080

# 监听地址。局域网访问需要 NAS 的实际 IP 或 0.0.0.0；
# 仅本机或由反向代理访问时使用 127.0.0.1。
MINDSYNC_BIND_ADDRESS=0.0.0.0

# 该库独立的数据目录（绝对路径）。其下 vault/ 是可读文件树，objects/ 是历史内容。
MINDSYNC_DATA_DIR=/vol1/1000/libraries/example

# 容器运行身份。命名卷时保持 10001（镜像内置用户）；
# bind mount 时由 add-library.sh 自动填成该数据目录的属主。
# 飞牛等存储层只放行已知用户，用未知 uid 会因 ACL 而写入失败。
MINDSYNC_RUN_UID=10001
MINDSYNC_RUN_GID=10001

# 单文件上限（字节）。默认 50 MiB；反向代理需同时放行同样大小的请求体。
MINDSYNC_MAX_FILE_BYTES=52428800

# compose 项目名与容器名。由 add-library.sh 自动填写：
# 第一个库使用干净名字（项目 mindsync、容器 mindsync 与 postgres）；
# 之后新增的库自动加后缀，因为容器名在宿主机上必须唯一。
MINDSYNC_PROJECT=mindsync
MINDSYNC_CONTAINER_NAME=mindsync
MINDSYNC_POSTGRES_CONTAINER_NAME=postgres

# 管理令牌：至少 32 位，用于注册和撤销设备。日常同步使用每设备独立令牌。
MINDSYNC_ADMIN_TOKEN=

# PostgreSQL 密码。建议只使用 A-Za-z0-9 与 - _ . ~ ! @ % ^ & * + = : ; ,
# 避免连接 URI 中的特殊字符问题。
POSTGRES_PASSWORD=
